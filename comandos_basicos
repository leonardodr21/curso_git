cd --> mudar diretório
ls --> lista os itens do diretório
pwd --> caminho absoluto do diretório que estou
ls -a --> mostra arquivos ocultos 
cd .. --> sube uma pagina acima  
mkdir nome_da_sua_pasta --> cria uma nova pasta
cat nome_arquivo --> mostra o conteudo
git init . --> torna a pasta em um repositorio de git
rm -rf .git --> torna a pasta git em uma pasta comun novamente 
rm -rf remove de forma recursiva e forçada todos os diretorios
rm --> remove arquivo ou diretorio
git status --> mostra o status do git
git add nome_arquivo --> adiciona o arquivo para ser committed/salvo pode ser adicionado mais de um arquivo apenas nescessario no commit
git commit -m "mensagem para adicionar no commit como descrição"
git config --global user.email "exemplo@email.com" --> adiciona email que vai ser utilizado para assinar os commit sem isso não funciona
git config --global user.name "exemplo" --> adiciona seu nome 
nano nome_arquivo --> abre editor de texto dentro do bash 
git log --> mostra as informações dos salvamentos como autor data e sua mensagem 
git add . --> adiciona para fazer commit todos arquivos da pasta atual 
git mv nome_antigo nome_novo --> renomear um arquivo
git diff nome_arquivo --> mostra a diferença do estado atual para a ultima versão salva
git reset nome_arquivo --> remove um arquivo que foi staged pelo git add 
git checkout -b nome_branch --> cria um nova branch e altera a posição para a nova branch
git branch --> mostra a branch atual
git checkout nome_branch --> altera branch