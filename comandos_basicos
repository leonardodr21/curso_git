cd --> mudar diretório
ls --> lista os itens do diretório
pwd --> caminho absoluto do diretório que estou
ls -a --> mostra arquivos ocultos 
cd .. --> sube uma pagina acima  
mkdir nome_da_sua_pasta --> cria uma nova pasta
cat nome_arquivo --> mostra o conteudo
git init . --> torna a pasta em um repositorio de git
rm -rf .git --> torna a pasta git em uma pasta comun novamente 

git status --> mostra o status do git
git add nome_arquivo --> adiciona o arquivo para ser committed/salvo
git commit -m "mensagem para adicionar no commit como descrição"
git config --global user.email "exemplo@email.com" --> adiciona email que vai ser utilizado para assinar os commit sem isso não funciona
git config --global user.name "exemplo" --> adiciona seu nome 